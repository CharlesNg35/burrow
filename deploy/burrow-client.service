[Unit]
Description=burrow reverse tunnel client
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/burrow client -c /etc/burrow/client.yaml
Restart=on-failure
RestartSec=2
User=burrow
Group=burrow
EnvironmentFile=-/etc/burrow/env
LimitNOFILE=1048576
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
