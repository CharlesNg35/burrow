{
  "schema_version": 1,
  "hash": "b2s:5b65f76ca667022f",
  "root": {
    "label": "Server",
    "sem": {
      "t": "object",
      "fields": [
        {
          "key": "listen",
          "node": {
            "label": "Listen address",
            "help": "Where the server waits for clients: ip:port like 0.0.0.0:7835, or a port alone for 0.0.0.0 (all IPv4 addresses)",
            "sem": {
              "t": "optional",
              "inner": {
                "sem": {
                  "t": "ip_port",
                  "ranges": false,
                  "default_ip": "0.0.0.0"
                }
              }
            },
            "applies": "restart",
            "group": "listener",
            "order": 10,
            "none_label": "No TCP listener"
          }
        },
        {
          "key": "public_address",
          "node": {
            "label": "Public address",
            "help": "How clients reach this server: a host name or IP (the port comes from listen), host:port, or a wss:// URL; client-config writes it into client configs",
            "sem": {
              "t": "optional",
              "inner": {
                "sem": {
                  "t": "server_address"
                }
              }
            },
            "applies": "live",
            "group": "listener",
            "order": 20,
            "none_label": "Not set"
          }
        },
        {
          "key": "websocket",
          "node": {
            "label": "WebSocket listener",
            "help": "Accept clients over WebSocket, for servers reachable only through HTTP(S)",
            "sem": {
              "t": "optional",
              "inner": {
                "label": "WebSocket",
                "sem": {
                  "t": "object",
                  "fields": [
                    {
                      "key": "listen",
                      "node": {
                        "label": "Listen address",
                        "help": "Address to accept WebSocket connections on, for example 127.0.0.1:7836 behind a proxy; a port alone means 0.0.0.0",
                        "sem": {
                          "t": "ip_port",
                          "ranges": false,
                          "default_ip": "0.0.0.0"
                        },
                        "required": true,
                        "order": 10
                      }
                    },
                    {
                      "key": "path",
                      "node": {
                        "label": "Path",
                        "help": "URL path clients connect to",
                        "sem": {
                          "t": "url_path"
                        },
                        "default": "/burrow",
                        "order": 20
                      }
                    },
                    {
                      "key": "tls",
                      "node": {
                        "label": "TLS",
                        "help": "Serve wss:// directly with these PEM files instead of behind a TLS proxy",
                        "sem": {
                          "t": "optional",
                          "inner": {
                            "label": "TLS files",
                            "sem": {
                              "t": "object",
                              "fields": [
                                {
                                  "key": "cert",
                                  "node": {
                                    "label": "Certificate file",
                                    "help": "Certificate chain PEM file, relative to the config file",
                                    "sem": {
                                      "t": "path",
                                      "must_exist": true,
                                      "relative_to": "config"
                                    },
                                    "required": true
                                  }
                                },
                                {
                                  "key": "key",
                                  "node": {
                                    "label": "Private key file",
                                    "help": "Private key PEM file, relative to the config file",
                                    "sem": {
                                      "t": "path",
                                      "must_exist": true,
                                      "relative_to": "config"
                                    },
                                    "required": true
                                  }
                                }
                              ]
                            }
                          }
                        },
                        "order": 30,
                        "none_label": "Behind a TLS proxy (plain ws://)"
                      }
                    },
                    {
                      "key": "keepalive_secs",
                      "node": {
                        "label": "Keepalive",
                        "help": "Seconds between keepalives on idle pooled channels, below your proxy's idle timeout",
                        "sem": {
                          "t": "duration",
                          "unit": "secs",
                          "min": 5,
                          "max": 30
                        },
                        "default": 25,
                        "order": 40,
                        "advanced": true
                      }
                    }
                  ]
                }
              }
            },
            "applies": "reload",
            "group": "websocket",
            "order": 30,
            "none_label": "Off"
          }
        },
        {
          "key": "clients",
          "node": {
            "label": "Clients",
            "help": "Clients allowed to connect, keyed by client name",
            "sem": {
              "t": "map",
              "key": {
                "sem": {
                  "t": "name",
                  "entity": "client",
                  "max_len": 64
                }
              },
              "value": {
                "label": "Client",
                "sem": {
                  "t": "object",
                  "fields": [
                    {
                      "key": "secret",
                      "node": {
                        "label": "Secrets",
                        "help": "256-bit secret (base64 or hex), or a list of them during rotation",
                        "sem": {
                          "t": "secret_ref",
                          "max": 4
                        },
                        "required": true
                      }
                    },
                    {
                      "key": "max_connections",
                      "node": {
                        "label": "Max connections",
                        "help": "Maximum concurrent forwarded connections for this client",
                        "sem": {
                          "t": "optional",
                          "inner": {
                            "sem": {
                              "t": "integer",
                              "min": 1,
                              "unit": "connections"
                            }
                          }
                        },
                        "advanced": true,
                        "none_label": "Server default",
                        "relations": [
                          {
                            "r": "default_from",
                            "path": "/limits/max_connections_per_client"
                          }
                        ]
                      }
                    }
                  ]
                },
                "entity": "client"
              }
            },
            "applies": "reload",
            "group": "entities",
            "order": 40
          }
        },
        {
          "key": "visitors",
          "node": {
            "label": "Visitors",
            "help": "Visitors allowed to reach private services with burrow visit, keyed by visitor name",
            "sem": {
              "t": "map",
              "key": {
                "sem": {
                  "t": "name",
                  "entity": "visitor",
                  "max_len": 64
                }
              },
              "value": {
                "label": "Visitor",
                "sem": {
                  "t": "object",
                  "fields": [
                    {
                      "key": "secret",
                      "node": {
                        "label": "Secrets",
                        "help": "256-bit secret (base64 or hex), or a list of them during rotation",
                        "sem": {
                          "t": "secret_ref",
                          "max": 4
                        },
                        "required": true
                      }
                    },
                    {
                      "key": "reach",
                      "node": {
                        "label": "Direct access to clients",
                        "help": "Clients this visitor may reach directly, with the targets it may pick there: any (whatever the client's allow list permits), or rules in allow-list syntax that narrow it, for example home: any, office: 192.168.150.0/25 or lab: [10.0.0.0/8:22, unix:/run/app.sock]",
                        "sem": {
                          "t": "ref_map",
                          "entity": "client",
                          "value": {
                            "sem": {
                              "t": "union",
                              "branches": [
                                {
                                  "sem": {
                                    "t": "enum",
                                    "options": [
                                      {
                                        "value": "any",
                                        "label": "any"
                                      }
                                    ]
                                  }
                                },
                                {
                                  "sem": {
                                    "t": "cidr_rule"
                                  }
                                },
                                {
                                  "sem": {
                                    "t": "list",
                                    "item": {
                                      "sem": {
                                        "t": "cidr_rule"
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        },
                        "group": "access",
                        "order": 20,
                        "empty_label": "No direct access"
                      }
                    },
                    {
                      "key": "max_connections",
                      "node": {
                        "label": "Max connections",
                        "help": "Maximum concurrent connections for this visitor",
                        "sem": {
                          "t": "optional",
                          "inner": {
                            "sem": {
                              "t": "integer",
                              "min": 1,
                              "unit": "connections"
                            }
                          }
                        },
                        "group": "traffic",
                        "advanced": true,
                        "none_label": "Unlimited"
                      }
                    },
                    {
                      "key": "admin",
                      "node": {
                        "label": "Admin access",
                        "help": "Let this visitor administer the server with burrow admin: read shows the dashboard and the config, write may also change it",
                        "sem": {
                          "t": "optional",
                          "inner": {
                            "sem": {
                              "t": "enum",
                              "options": [
                                {
                                  "value": "read",
                                  "label": "Read",
                                  "help": "Dashboard, config with secrets as fingerprints, history"
                                },
                                {
                                  "value": "write",
                                  "label": "Write",
                                  "help": "Everything read gives, and changing the config",
                                  "danger": true
                                }
                              ]
                            }
                          }
                        },
                        "group": "admin",
                        "order": 40,
                        "danger_when_set": true,
                        "none_label": "None"
                      }
                    },
                    {
                      "key": "admin_from",
                      "node": {
                        "label": "Admin only from",
                        "help": "Admin access only from these source IPs or CIDRs, for example [203.0.113.0/24]; any address when empty",
                        "sem": {
                          "t": "list",
                          "item": {
                            "sem": {
                              "t": "cidr"
                            }
                          }
                        },
                        "group": "admin",
                        "order": 41,
                        "empty_label": "Any address",
                        "relations": [
                          {
                            "r": "visible_if",
                            "cond": {
                              "set": "admin"
                            }
                          }
                        ]
                      }
                    }
                  ]
                },
                "groups": [
                  {
                    "key": "access",
                    "label": "Access"
                  },
                  {
                    "key": "admin",
                    "label": "Administration"
                  },
                  {
                    "key": "traffic",
                    "label": "Traffic"
                  }
                ],
                "entity": "visitor"
              }
            },
            "applies": "reload",
            "group": "entities",
            "order": 41
          }
        },
        {
          "key": "services",
          "node": {
            "label": "Services",
            "help": "Exposed services, keyed by service name",
            "sem": {
              "t": "map",
              "key": {
                "sem": {
                  "t": "name",
                  "entity": "service",
                  "max_len": 64
                }
              },
              "value": {
                "label": "Service",
                "sem": {
                  "t": "object",
                  "fields": [
                    {
                      "key": "client",
                      "node": {
                        "label": "Client",
                        "help": "Name of the client that reaches the target",
                        "sem": {
                          "t": "optional",
                          "inner": {
                            "sem": {
                              "t": "ref",
                              "entity": "client"
                            }
                          }
                        },
                        "group": "who",
                        "order": 10,
                        "none_label": "None",
                        "relations": [
                          {
                            "r": "one_of",
                            "group": "who"
                          }
                        ]
                      }
                    },
                    {
                      "key": "clients",
                      "node": {
                        "label": "Clients",
                        "help": "Several clients that can each reach the target, instead of client; see mode",
                        "sem": {
                          "t": "ref_list",
                          "entity": "client",
                          "ordered": true,
                          "unique": true
                        },
                        "group": "who",
                        "order": 11,
                        "relations": [
                          {
                            "r": "one_of",
                            "group": "who"
                          }
                        ]
                      }
                    },
                    {
                      "key": "mode",
                      "node": {
                        "label": "Mode",
                        "help": "With several clients: failover uses the first one that is up, balance spreads new connections over all of them",
                        "sem": {
                          "t": "enum",
                          "options": [
                            {
                              "value": "failover",
                              "label": "Failover",
                              "help": "Use the first client that is up"
                            },
                            {
                              "value": "balance",
                              "label": "Balance",
                              "help": "Spread new connections over all clients"
                            }
                          ]
                        },
                        "default": "failover",
                        "group": "who",
                        "order": 12,
                        "relations": [
                          {
                            "r": "visible_if",
                            "cond": {
                              "len_ge": [
                                "clients",
                                2
                              ]
                            }
                          },
                          {
                            "r": "enabled_if",
                            "cond": {
                              "eq": [
                                "protocol",
                                "tcp"
                              ]
                            },
                            "reason": "UDP services do not support this"
                          }
                        ]
                      }
                    },
                    {
                      "key": "health_check",
                      "node": {
                        "label": "Health check",
                        "help": "Check that each client can reach the target, and send connections only to those that can: true, or a map with interval_secs, timeout_secs and failures",
                        "sem": {
                          "t": "optional",
                          "inner": {
                            "sem": {
                              "t": "union",
                              "branches": [
                                {
                                  "sem": {
                                    "t": "bool"
                                  }
                                },
                                {
                                  "label": "Health check settings",
                                  "sem": {
                                    "t": "object",
                                    "fields": [
                                      {
                                        "key": "interval_secs",
                                        "node": {
                                          "label": "Interval",
                                          "help": "Seconds between checks of each client",
                                          "sem": {
                                            "t": "duration",
                                            "unit": "secs",
                                            "min": 1,
                                            "max": 3600
                                          },
                                          "default": 10
                                        }
                                      },
                                      {
                                        "key": "timeout_secs",
                                        "node": {
                                          "label": "Timeout",
                                          "help": "Seconds a check may take",
                                          "sem": {
                                            "t": "duration",
                                            "unit": "secs",
                                            "min": 1,
                                            "max": 60
                                          },
                                          "default": 3
                                        }
                                      },
                                      {
                                        "key": "failures",
                                        "node": {
                                          "label": "Failures before down",
                                          "help": "Failed checks in a row before a client counts as down",
                                          "sem": {
                                            "t": "integer",
                                            "min": 1,
                                            "max": 100,
                                            "unit": "checks"
                                          },
                                          "default": 2
                                        }
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          }
                        },
                        "group": "who",
                        "order": 13,
                        "advanced": true,
                        "none_label": "Off",
                        "relations": [
                          {
                            "r": "enabled_if",
                            "cond": {
                              "eq": [
                                "protocol",
                                "tcp"
                              ]
                            },
                            "reason": "UDP services do not support this"
                          }
                        ]
                      }
                    },
                    {
                      "key": "bind",
                      "node": {
                        "label": "Public address",
                        "help": "Public address on the server: a port, or ip:port; leave it out for a private service that only visitors reach",
                        "sem": {
                          "t": "optional",
                          "inner": {
                            "sem": {
                              "t": "ip_port",
                              "ranges": true,
                              "max_range": 1000,
                              "default_ip": "0.0.0.0"
                            }
                          }
                        },
                        "group": "exposure",
                        "order": 20,
                        "none_label": "Private: no public port",
                        "relations": [
                          {
                            "r": "cross",
                            "paths": [
                              "target",
                              "protocol"
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "key": "target",
                      "node": {
                        "label": "Target on the client",
                        "help": "host:port as seen from the client, or a port alone for 127.0.0.1 on the client",
                        "sem": {
                          "t": "target",
                          "ranges": true,
                          "unix": true
                        },
                        "required": true,
                        "group": "exposure",
                        "order": 21,
                        "relations": [
                          {
                            "r": "same_len",
                            "path": "bind"
                          },
                          {
                            "r": "cross",
                            "paths": [
                              "bind",
                              "protocol"
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "key": "protocol",
                      "node": {
                        "label": "Protocol",
                        "sem": {
                          "t": "enum",
                          "options": [
                            {
                              "value": "tcp",
                              "label": "TCP"
                            },
                            {
                              "value": "udp",
                              "label": "UDP"
                            }
                          ]
                        },
                        "default": "tcp",
                        "group": "exposure",
                        "order": 22
                      }
                    },
                    {
                      "key": "max_connections",
                      "node": {
                        "label": "Max connections",
                        "help": "Maximum concurrent connections for this service",
                        "sem": {
                          "t": "optional",
                          "inner": {
                            "sem": {
                              "t": "integer",
                              "min": 1,
                              "unit": "connections"
                            }
                          }
                        },
                        "group": "traffic",
                        "order": 40,
                        "none_label": "Unlimited",
                        "relations": [
                          {
                            "r": "enabled_if",
                            "cond": {
                              "eq": [
                                "protocol",
                                "tcp"
                              ]
                            },
                            "reason": "UDP services do not support this"
                          }
                        ]
                      }
                    },
                    {
                      "key": "visitors",
                      "node": {
                        "label": "Visitors",
                        "help": "Visitors that may reach this service with burrow visit",
                        "sem": {
                          "t": "ref_list",
                          "entity": "visitor",
                          "ordered": false,
                          "unique": true
                        },
                        "group": "access",
                        "order": 30,
                        "empty_label": "No visitors",
                        "relations": [
                          {
                            "r": "enabled_if",
                            "cond": {
                              "eq": [
                                "protocol",
                                "tcp"
                              ]
                            },
                            "reason": "UDP services do not support this"
                          },
                          {
                            "r": "inverse",
                            "entity": "visitor",
                            "field": "visitors",
                            "label": "Services it may use"
                          },
                          {
                            "r": "options_filter",
                            "cond": {
                              "eq": [
                                "protocol",
                                "tcp"
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "key": "allow_from",
                      "node": {
                        "label": "Only from",
                        "help": "Only these source IPs or CIDRs may connect, for example [203.0.113.0/24]; everyone when empty",
                        "sem": {
                          "t": "list",
                          "item": {
                            "sem": {
                              "t": "cidr"
                            }
                          }
                        },
                        "group": "access",
                        "order": 31,
                        "empty_label": "Everyone may connect"
                      }
                    },
                    {
                      "key": "deny_from",
                      "node": {
                        "label": "Never from",
                        "help": "Source IPs or CIDRs that may never connect",
                        "sem": {
                          "t": "list",
                          "item": {
                            "sem": {
                              "t": "cidr"
                            }
                          }
                        },
                        "group": "access",
                        "order": 32,
                        "advanced": true,
                        "empty_label": "Nobody is blocked"
                      }
                    },
                    {
                      "key": "proxy_protocol",
                      "node": {
                        "label": "PROXY protocol",
                        "help": "Send the real source address to the target with the PROXY protocol, v1 (text) or v2 (binary); only for targets that expect it",
                        "sem": {
                          "t": "optional",
                          "inner": {
                            "sem": {
                              "t": "enum",
                              "options": [
                                {
                                  "value": "v1",
                                  "label": "v1 (text)"
                                },
                                {
                                  "value": "v2",
                                  "label": "v2 (binary)"
                                }
                              ]
                            }
                          }
                        },
                        "group": "traffic",
                        "order": 42,
                        "advanced": true,
                        "none_label": "Off",
                        "relations": [
                          {
                            "r": "enabled_if",
                            "cond": {
                              "eq": [
                                "protocol",
                                "tcp"
                              ]
                            },
                            "reason": "UDP services do not support this"
                          }
                        ]
                      }
                    },
                    {
                      "key": "bandwidth",
                      "node": {
                        "label": "Speed limit",
                        "help": "Speed limit for each direction, shared by all connections of this service, for example 40mbit or 5MB (per second)",
                        "sem": {
                          "t": "optional",
                          "inner": {
                            "sem": {
                              "t": "rate"
                            }
                          }
                        },
                        "group": "traffic",
                        "order": 41,
                        "none_label": "Unlimited"
                      }
                    }
                  ]
                },
                "groups": [
                  {
                    "key": "who",
                    "label": "Where it runs"
                  },
                  {
                    "key": "exposure",
                    "label": "Exposure"
                  },
                  {
                    "key": "access",
                    "label": "Access"
                  },
                  {
                    "key": "traffic",
                    "label": "Traffic"
                  }
                ],
                "entity": "service"
              }
            },
            "applies": "reload",
            "group": "entities",
            "order": 42
          }
        },
        {
          "key": "insecure_plaintext",
          "node": {
            "label": "Disable encryption of forwarded data",
            "help": "Disable encryption of forwarded data (authentication still runs)",
            "sem": {
              "t": "bool"
            },
            "default": false,
            "applies": "live",
            "group": "security",
            "order": 90,
            "danger_when_set": true
          }
        },
        {
          "key": "heartbeat",
          "node": {
            "label": "Heartbeat",
            "sem": {
              "t": "object",
              "fields": [
                {
                  "key": "interval_secs",
                  "node": {
                    "label": "Interval",
                    "help": "How often the server and each client check that the other is still there",
                    "sem": {
                      "t": "duration",
                      "unit": "secs",
                      "min": 1,
                      "max": 3600
                    },
                    "default": 10
                  }
                }
              ]
            },
            "applies": "live",
            "group": "network",
            "order": 60
          }
        },
        {
          "key": "limits",
          "node": {
            "label": "Limits",
            "sem": {
              "t": "object",
              "fields": [
                {
                  "key": "handshake_timeout_secs",
                  "node": {
                    "label": "Handshake timeout",
                    "help": "Time a new connection has to authenticate",
                    "sem": {
                      "t": "duration",
                      "unit": "secs",
                      "min": 1,
                      "max": 120
                    },
                    "default": 5,
                    "applies": "live"
                  }
                },
                {
                  "key": "max_handshakes",
                  "node": {
                    "label": "Max handshakes",
                    "help": "Concurrent connections that have not finished authenticating",
                    "sem": {
                      "t": "integer",
                      "min": 1,
                      "max": 1000000,
                      "unit": "connections"
                    },
                    "default": 256,
                    "applies": "reload"
                  }
                },
                {
                  "key": "max_connections_per_client",
                  "node": {
                    "label": "Max connections per client",
                    "help": "Concurrent forwarded connections of one client, unless the client sets its own",
                    "sem": {
                      "t": "integer",
                      "min": 1,
                      "unit": "connections"
                    },
                    "default": 8192,
                    "applies": "live"
                  }
                },
                {
                  "key": "max_pending",
                  "node": {
                    "label": "Max waiting connections",
                    "help": "Connections waiting for a data channel, per client",
                    "sem": {
                      "t": "integer",
                      "min": 1,
                      "unit": "connections"
                    },
                    "default": 512,
                    "applies": "reload"
                  }
                }
